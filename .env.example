# LLM provider — set one of the following
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# LLM / embedding config
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=5

# Vector store
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=parking_knowledge

# Relational database
# Use postgresql://user:password@host:port/dbname for production
# Use sqlite:///./chatbot.db for local development without Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot

# API
ADMIN_TOKEN=change-me-before-deploying
API_HOST=0.0.0.0
API_PORT=8000

# SMTP / Admin approval (Stage 3 — Human-in-the-Loop)
# For local dev use MailHog: docker compose up mailhog
# MailHog SMTP listens on port 1025; web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=chatbot@parking.local
ADMIN_EMAIL=admin@parking.local
APPROVAL_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=INFO
