# Redirect HTTP → HTTPS for both domains
server {
    listen 80;
    server_name ${CHATBOT_DOMAIN} ${MAIL_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${CHATBOT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CHATBOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CHATBOT_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location /admin/reservation/ {
        resolver           127.0.0.11 valid=10s;
        set $api           http://api:8000;
        proxy_pass         $api;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    location / {
        resolver           127.0.0.11 valid=10s;
        set $ui            http://ui:8501;
        proxy_pass         $ui;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }
}

server {
    listen 443 ssl;
    server_name ${MAIL_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MAIL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MAIL_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location / {
        resolver           127.0.0.11 valid=10s;
        set $mailhog       http://mailhog:8025;
        proxy_pass         $mailhog;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }
}
